@{
    ViewData["Title"] = "Customer Management";
}

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f4f7fb;
    }

    .customer-page {
        padding: 35px;
    }

    .customer-header {
        background: linear-gradient(135deg, #1261a0, #073b70);
        color: white;
        padding: 28px;
        border-radius: 18px;
        margin-bottom: 25px;
    }

    .customer-header h1 {
        margin: 0 0 8px;
        font-size: 30px;
    }

    .customer-header p {
        margin: 0;
        opacity: 0.9;
    }

    .customer-form {
        max-width: 800px;
        margin: auto;
        background: white;
        padding: 35px;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    }

    .customer-form h2 {
        color: #16324f;
        margin-bottom: 25px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        font-weight: bold;
        color: #34495e;
        margin-bottom: 8px;
    }

    .form-control {
        width: 100%;
        padding: 13px;
        border: 1px solid #d5dce5;
        border-radius: 9px;
        font-size: 15px;
        outline: none;
    }

    .form-control:focus {
        border-color: #1261a0;
        box-shadow: 0 0 0 3px rgba(18,97,160,0.12);
    }

    .save-btn {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 9px;
        background: linear-gradient(90deg, #1261a0, #198754);
        color: white;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
    }

    .save-btn:hover {
        transform: translateY(-2px);
    }

    .back-btn {
        display: inline-block;
        margin-top: 15px;
        color: #1261a0;
        text-decoration: none;
    }

    @@media (max-width: 700px) {
        .form-row {
            grid-template-columns: 1fr;
        }

        .customer-page {
            padding: 15px;
        }
    }

    .success-message {
        background: #d4edda;
        color: #155724;
        padding: 12px 20px;
        margin-bottom: 20px;
        border-radius: 8px;
        text-align: center;
        font-weight: bold;
    }
</style>
 
@if (TempData["SuccessMessage"] != null)
{
    <div class="success-message">
        @TempData["SuccessMessage"]
    </div>
}

<div class="customer-page">

    <div class="customer-header">
        <h1>👤 Customer Management</h1>
        <p>Add and manage insurance customers</p>
    </div>

    <div class="customer-form">

        <h2>➕ Add New Customer</h2>

        <form method="post">

            <div class="form-row">

                <div class="form-group">
                    <label> Name</label>
                    <input type="text"
                           name="Name"
                           class="form-control"
                           placeholder="Enter customer name"
                           required />
                </div>
                 
                <div class="form-group">
                    <label>Date of Birth</label>
                    <input type="date"
                           name="DateOfBirth"
                           class="form-control"
                           required />
                </div>

                <div class="form-group">
                    <label>Gender</label>
                    <select name="Gender" class="form-control" required>
                        <option value="">Select Gender</option>
                        <option>Male</option>
                        <option>Female</option>
                        <option>Other</option>
                    </select>
                </div>
                </div>
            

            <div class="form-row">

                <div class="form-group">
                    <label>Email</label>
                    <input type="email"
                           name="Email"
                           class="form-control"
                           placeholder="Enter email"
                           required />
                </div>

                <div class="form-group">
                    <label>Mobile</label>
                    <input type="tel"
                           name="Mobile"
                           class="form-control"
                           placeholder="Enter Mobile number"
                           … required />
                </div>
                <div class="form-group">
                    <label>Address</label>
                    <textarea name="Address"
                              class="form-control"
                              rows="3"
                              placeholder="Enter customer address"
                              required></textarea>
                </div>

                <button type="submit" class="save-btn">
                    💾 Save Customer
                </button>

            </form>

            <a href="/Home/Dashboard" class="back-btn">
                ← Back to Dashboard
            </a>

        </div>

    </div>