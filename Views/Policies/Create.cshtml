@model InsuranceManagmentSystem.Models.Policy

@{
    ViewData["Title"] = "Create Policy";
}

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f4f7fb;
    }

    .policy-create-page {
        padding: 35px;
    }

    .policy-header {
        background: linear-gradient(135deg, #1261a0, #073b70);
        color: white;
        padding: 30px;
        border-radius: 20px;
        margin-bottom: 30px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.10);
    }

        .policy-header h1 {
            margin: 0 0 10px;
            font-size: 32px;
        }

        .policy-header p {
            margin: 0;
            opacity: 0.9;
            font-size: 15px;
        }

    .policy-form {
        max-width: 850px;
        margin: auto;
        background: white;
        padding: 35px;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    }

        .policy-form h2 {
            margin-top: 0;
            margin-bottom: 8px;
            color: #16324f;
            font-size: 24px;
        }

    .form-subtitle {
        color: #777;
        margin-bottom: 28px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
    }

    .form-group {
        margin-bottom: 22px;
    }

        .form-group label {
            display: block;
            font-weight: bold;
            color: #34495e;
            margin-bottom: 8px;
        }

    .form-control {
        width: 100%;
        padding: 13px;
        border: 1px solid #d5dce5;
        border-radius: 9px;
        font-size: 15px;
        box-sizing: border-box;
        background: white;
    }

        .form-control:focus {
            border-color: #1261a0;
            box-shadow: 0 0 0 3px rgba(18,97,160,0.12);
            outline: none;
        }

    .create-btn {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 9px;
        background: linear-gradient(90deg, #1261a0, #198754);
        color: white;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        margin-top: 5px;
    }

        .create-btn:hover {
            transform: translateY(-2px);
        }

    .back-btn {
        display: inline-block;
        margin-top: 20px;
        color: #1261a0;
        text-decoration: none;
        font-weight: bold;
    }

        .back-btn:hover {
            text-decoration: underline;
        }

    .validation {
        color: #dc3545;
        font-size: 13px;
    }

    @@media (max-width: 700px) {
        .policy-create-page {
            padding: 15px;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .policy-form {
            padding: 25px;
        }
    }
</style>

<div class="policy-create-page">

    <div class="policy-header">
        <h1>📄 Create Insurance Policy</h1>
        <p>Add a new insurance policy to the system</p>
    </div>

    <div class="policy-form">

        <h2>➕ Policy Details</h2>
        <p class="form-subtitle">
            Enter the details below to create a new insurance policy.
        </p>

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <div class="form-group">
                <label asp-for="CustomerID">Customer</label>

                <select asp-for="CustomerID"
                        class="form-control"
                        asp-items="ViewBag.CustomerID">

                    <option value="">-- Select Customer --</option>

                </select>
                <div class="form-group">
                    <label asp-for="AgentID" class="control-label">Agent Name</label>
                    <select asp-for="AgentID"
                            class="form-control"
                            asp-items="ViewBag.AgentID">
                        <option value="">-- Select Agent --</option>
                    </select>
                </div>

                <span asp-validation-for="CustomerID"
                      class="validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="PolicyType">Policy Type</label>

                <select asp-for="PolicyType" class="form-control">

                    <option value="">-- Select Policy Type --</option>
                    <option value="Life Insurance">Life Insurance</option>
                    <option value="Health Insurance">Health Insurance</option>
                    <option value="Vehicle Insurance">Vehicle Insurance</option>
                    <option value="Home Insurance">Home Insurance</option>
                    <option value="Travel Insurance">Travel Insurance</option>

                </select>

                <span asp-validation-for="PolicyType"
                      class="validation"></span>
            </div>

            <div class="form-row">

                <div class="form-group">
                    <label asp-for="PremiumAmount">Premium Amount</label>

                    <input asp-for="PremiumAmount"
                           class="form-control"
                           placeholder="Enter premium amount"
                           type="number"
                           step="0.01" />

                    <span asp-validation-for="PremiumAmount"
                          class="validation"></span>
                </div>
                <div class="form-group">

    <label>Coverage Amount</label>
    <input type="number"
           name="CoverageAmount"
           class="form-control"
           placeholder="Enter Coverage Amount"
           step="0.01"
           required />
</div>

                <div class="form-group">
                    <label asp-for="StartDate">Start Date</label>

                    <input asp-for="StartDate"
                           class="form-control"
                           type="date" />

                    <span asp-validation-for="StartDate"
                          class="validation"></span>
                </div>

            </div>

            <div class="form-group">
                <label asp-for="EndDate">End Date</label>

                <input asp-for="EndDate"
                       class="form-control"
                       type="date" />

                <span asp-validation-for="EndDate"
                      class="validation"></span>
            </div>

            <button type="submit" class="create-btn">
                💾 Create Policy
            </button>

        </form>

        <a asp-action="Index" class="back-btn">
            ← Back to Policies
        </a>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}